{
  "id": "mikrotik",
  "title": "MikroTik RouterOS log lines: topics and message (free text, mined quota)",
  "kinds": [
    "mikrotik"
  ],
  "rule": {
    "type": "template",
    "prefix": "^(?P<head>[a-z][a-z0-9-]*(?:,[a-z][a-z0-9-]*)*) ",
    "src_pattern": "(?P<src>\\d{1,3}(?:\\.\\d{1,3}){3})(?::\\d+)?->",
    "dst_pattern": "->(?P<dst>\\d{1,3}(?:\\.\\d{1,3}){3})",
    "remote_patterns": [
      "proto \\S+(?: \\([^)]*\\))?, (?P<addr>\\d{1,3}(?:\\.\\d{1,3}){3})(?::\\d+)?->",
      "\\bfrom (?P<addr>[0-9A-Fa-f:.]{1,45}) via \\w+"
    ],
    "conn_refuse": "connection-state:(?:established|related|invalid|untracked)",
    "conn_pattern": "proto TCP \\(SYN\\), (?P<local>\\d{1,3}(?:\\.\\d{1,3}){3})(?::\\d+)?->(?P<dest>\\d{1,3}(?:\\.\\d{1,3}){3})(?::\\d+)?",
    "head_vocab": [
      "system",
      "info",
      "error",
      "warning",
      "critical",
      "debug",
      "account",
      "firewall",
      "dhcp",
      "wireless",
      "interface",
      "route",
      "ppp",
      "pppoe",
      "l2tp",
      "ovpn",
      "sstp",
      "pptp",
      "ipsec",
      "script",
      "snmp",
      "web-proxy",
      "hotspot",
      "dns",
      "ntp",
      "bridge",
      "vrrp",
      "ospf",
      "bgp",
      "e-mail",
      "caps",
      "certificate",
      "gsm",
      "health",
      "lcd",
      "ldp",
      "manager",
      "mme",
      "mpls",
      "pim",
      "radius",
      "raw",
      "read",
      "rip",
      "store",
      "telephony",
      "tftp",
      "timer",
      "upnp",
      "user",
      "watchdog",
      "wireguard",
      "write",
      "packet",
      "async",
      "backup",
      "bfd",
      "event",
      "fetch",
      "igmp-proxy",
      "iscsi",
      "kvm",
      "lte",
      "ike",
      "container",
      "hotspot-ap",
      "ipv6",
      "dot1x",
      "romon",
      "rose-storage",
      "tr069",
      "ups",
      "zerotier"
    ]
  },
  "samples": [
    {
      "line": "<134>Nov  9 10:00:00 RT system,info,account user admin logged in from 192.168.10.113 via winbox",
      "signature": "system,info,account: user <name> logged in from <ip> via winbox",
      "remote": "192.168.10.113"
    },
    {
      "line": "firewall,info forward: in:ether1 out:ether2, proto TCP (SYN), 192.168.10.113:50922->8.8.8.8:53, len 60",
      "signature": "firewall,info: forward: in:ether<n> out:ether<n>, proto TCP (SYN), <ip>-><ip>, len <n>",
      "src": "192.168.10.113",
      "dest": "8.8.8.8",
      "remote": "192.168.10.113",
      "local": "192.168.10.113",
      "dests": [
        "ip:8.8.8.8"
      ]
    }
  ]
}
