{
  "id": "sonicwall",
  "title": "SonicWall SonicOS syslog: id=firewall key=value lines, Connection Opened",
  "kinds": [
    "sonicwall"
  ],
  "rule": {
    "type": "template",
    "prefix": "^id=firewall sn=[0-9A-Za-z]{1,32} time=\"[^\"]{1,40}\" fw=[0-9A-Za-z.:_-]{1,64} pri=[0-9] c=[0-9]{1,10} m=[0-9]{1,5} msg=\"(?P<head>[A-Za-z0-9 ,.()/-]{1,64})\"",
    "conn_patterns": [
      {
        "pattern": "^id=firewall sn=[0-9A-Za-z]{1,32} time=\"[^\"]{1,40}\" fw=[0-9A-Za-z.:_-]{1,64} pri=[0-9] c=[0-9]{1,10} m=[0-9]{1,5} msg=\"Connection Opened\"(?: [A-Za-z]{1,12}=(?:\"[^\"]{0,64}\"|[^ \"]{0,64})){0,6} src=(?P<local>\\d{1,3}(?:\\.\\d{1,3}){3}):[0-9]{1,5}:[^ \"]{1,64} dst=(?P<dest>\\d{1,3}(?:\\.\\d{1,3}){3}):[0-9]{1,5}:[^ \"]{1,64}(?: |$)"
      }
    ]
  },
  "samples": [
    {
      "line": "<134>id=firewall sn=0006B1D1A5C4 time=\"2026-11-09 10:00:00 UTC\" fw=203.0.113.1 pri=6 c=262144 m=98 msg=\"Connection Opened\" n=1 src=192.168.10.113:51234:X0 dst=185.220.101.47:443:X1 proto=tcp/https",
      "signature": "Connection Opened: n=<n> src=<v> dst=<v> proto=<v>",
      "local": "192.168.10.113",
      "dests": [
        "ip:185.220.101.47"
      ]
    }
  ]
}
