# The pins of the container images (D-146): the only place a version or a hash of anything inside an image is written.
# KEY=VALUE only (the Makefile includes this file and passes every value to the builds as --build-arg).
#
# To bump one: change the value together with its hash in the same commit, then `make images-check` (builds the images and checks them
# by effect) and, for nuclei, the lab checks of .ai/deferred/feat-sensor-nuclei.md (the flags of modules/scan/nucleiargv are those of the
# pinned version). Hashes: `sha256sum` of the downloaded nuclei source archive, `docker pull` for an image digest (the digest of the multi-arch index, not of one platform).

# Bases, by digest of the multi-architecture index. Debian 13 "trixie" slim; Go matches go.mod; distroless static has no shell.
DEBIAN_IMAGE=docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
GOLANG_IMAGE=docker.io/library/golang:1.26.11-trixie@sha256:fa340cb59ebeb1d53ac1cccfc334201d938fe5f3458003cccb767096d8e032b8
DISTROLESS_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329

# nuclei (MIT), built from source (D-319): the tag archive https://github.com/projectdiscovery/nuclei/archive/refs/tags/v<version>.tar.gz,
# SHA-256 below (checked before it is unpacked), with our pinned Go and the patched go.mod/go.sum of deploy/containers/scan-base/nuclei/
# (its README.md says how to remake them; redo it on every bump of NUCLEI_VERSION).
NUCLEI_VERSION=3.11.1
NUCLEI_SRC_SHA256=64c6e21eb8cd141d39cbb0241228fb40fd4370dbe39dc9f13e1069c718b711f9

# The template pack (scripts/scanpack): built from the tag archive of nuclei-templates (MIT) at this version, whose SHA-256 is below;
# SCAN_PACK_VERSION is the pack's own version (AAAA.M.N), raised whenever the source version or the filter changes (the filter includes
# the own_ip rule of D-520 in scripts/scanpack and modules/scan/pack, once a pack of that version has shipped). 2026.11.3: no template
# that changes state, goes to another host or port, or makes anyone reach a third party (D-528). 2026.11.4: only read-only GETs and
# the templates of scripts/scanpack/reviewed.tsv (D-528 step 2).
NUCLEI_TEMPLATES_VERSION=10.5.1
NUCLEI_TEMPLATES_SHA256=30fe1cfaced4635f886e4a2673641bba86998dceec28e468274524e789aa56eb
SCAN_PACK_VERSION=2026.11.4

# nmap is NOT in any image the project publishes (D-113 (7), D-4). vedette-host installs the CURRENT Debian package on the box, on top of
# scan-base, from scan/Containerfile.onbox (slice SP-6), so security fixes flow in; the build fails unless `nmap --version` is at least
# this floor (D-146 (11)). The same file builds the dev image of `make scan-image`.
NMAP_MIN_VERSION=7.95

# The honeypot image (WP-08e, D-162). OPENCANARY_VERSION is the one version chosen by hand: it must equal deploy/containers/honeypot/requirements.in,
# and requirements.txt (made by lock.py, every dependency pinned with the hash of every file) must pin it; the build and a test check both. To bump it:
# change requirements.in and this line, run lock.py (its header says how), review the diff of requirements*.txt, `make honeypot-check`.
# Samba comes from the Debian 13 repositories at build time, like nmap (D-146 (11)); the build fails below this floor (a Debian version, with its epoch).
OPENCANARY_VERSION=0.9.10
SAMBA_MIN_VERSION=2:4.22

# ZAP (Apache-2.0; the image bundles OpenJDK and Debian), the passive web scan of Exposure (D-521, D-562): the upstream image, run
# unmodified as a one-shot container by vedette-host (zap.baseline) and pulled by this digest the first time a box needs it, never built
# or published by Vedette. Upstream does not sign it with our key: integrity is the digest of the multi-architecture index (an exception
# to D-57 (3), D-521). host/ops zapImage and install.sh's ZAP_IMAGE are this value without the tag (TestZapPinsAgree). To bump: the
# Docker-Content-Digest of the new 2.x tag's index from ghcr.io (a registry manifest request, no pull), here and in both places.
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0@sha256:9624669db72f54d86c4b46a7064518bd9bf79d8c61a4c31befa9923489f328af

# OpenVAS (Greenbone Community Edition, AGPL/GPL, D-529, FULL-2): the images of Greenbone's official compose project that run code, by the
# digest of each multi-architecture index (registry.community.greenbone.net, checked 2026-11-14 by a registry manifest request).
# deploy/greenbone/compose.yaml names each one with Greenbone's tag before the digest; the value here is the same without the tag
# (TestGreenbonePinsAgree keeps them equal). Upstream does not sign them with our key: integrity is the digest (as for ZAP, D-521). The
# seven feed data images are not pinned on purpose (compose.yaml says why). vedette-host pulls them only once an administrator enables
# OpenVAS. To bump one: the Docker-Content-Digest of the tag's index, here and in compose.yaml in the same commit.
GREENBONE_GPG_DATA_IMAGE=registry.community.greenbone.net/community/gpg-data@sha256:9495e444f1fc5ed48645239331390d45b37988bcc4f841c3b99324240194b2de
GREENBONE_REDIS_SERVER_IMAGE=registry.community.greenbone.net/community/redis-server@sha256:6da6a7c7221aa3ab231961fd6ca001d552b6a2c7727ac6201c6d8a360baa963a
GREENBONE_PG_GVM_IMAGE=registry.community.greenbone.net/community/pg-gvm@sha256:a18d9e2f0cbba7839e65547a2331ce8f984500e8c4fbe91d08f9a48036d03fa2
GREENBONE_PG_GVM_MIGRATOR_IMAGE=registry.community.greenbone.net/community/pg-gvm-migrator@sha256:8fc1cc11cac0481674527e01ec7610a8195110cf117d700bd47fe3af7012b34d
GREENBONE_GVMD_IMAGE=registry.community.greenbone.net/community/gvmd@sha256:e59a6a684b112ea77fe4ddd7e5ca35e6a07d36bf854f1b411d11d12f9b0c608a
GREENBONE_GSA_IMAGE=registry.community.greenbone.net/community/gsa@sha256:2868c871c719e3d5079117f9ad31a4c1356d4aecd455962b90509d5de9c45a16
GREENBONE_GSAD_IMAGE=registry.community.greenbone.net/community/gsad@sha256:8b2d983d934981c5f1c5cf95e3165489595e36679ff899d60ba4a4fe565d3aec
GREENBONE_GVM_CONFIG_IMAGE=registry.community.greenbone.net/community/gvm-config@sha256:4145869def040787ad478182c1d8b87a232f8e156c52bc74d9edfa16be84c1ab
GREENBONE_NGINX_IMAGE=registry.community.greenbone.net/community/nginx@sha256:5cdfd1af0dcdf886559dc4a38ff323608bee54ecdb7a464d5d72c148d579fa08
GREENBONE_OPENVAS_SCANNER_IMAGE=registry.community.greenbone.net/community/openvas-scanner@sha256:c9dd880d314ba078d2c1b3609af45c837a2481a60c93c079caf8c818f17ebf13
GREENBONE_OSPD_OPENVAS_IMAGE=registry.community.greenbone.net/community/ospd-openvas@sha256:31a85272abc77521c98451ce6834ed7d2f887e98ff1b26ff3fd94f00d000b169
GREENBONE_GVM_TOOLS_IMAGE=registry.community.greenbone.net/community/gvm-tools@sha256:53d294ab34b1a7fe3582826560aa8a6dcdfb395e396b195a03dd7d4b3b9cd885
