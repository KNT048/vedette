#!/bin/sh
# vedette-host postinst (WP-08g, D-155). POSIX sh, idempotent: a second run leaves the same users, directories, modes and
# /etc/subuid lines. Creates what vedette-host expects at fixed paths and enables the unit. A first install does NOT start it, and
# nothing here writes /etc/vedette/host.conf: the installer (WP-08h) does that from `getent`, then starts vedette-host.service.
# An UPGRADE restarts the unit when it is running (restart_after_upgrade), so the old daemon never outlives the new package.
# Everything is checked before anything is created: a refusal leaves no half-made state behind.
set -eu
umask 022

# Fixed names, dynamic ids (Debian Policy 9.2.2: system ids are allocated by useradd --system, not picked by the package).
# The ids stay the same on every later install because the users are never removed (not even by purge).
CORE=vedette           # user and group: core runs as it (core_uid, core_gid = socket_gid in host.conf), the socket group
SENSOR=vedette-sensor  # user and group of the sensor and scan containers (sensor_uid, sensor_gid)
UNIT=vedette-host.service

fail() {
	echo "vedette-host: $*" >&2
	exit 1
}

# ---- accounts ------------------------------------------------------------------------------------------------------------

defs() { # defs <key> <default>: a number from /etc/login.defs
	v=
	[ ! -r /etc/login.defs ] || v=$(awk -v k="$1" '$1 == k { v = $2 } END { print v }' /etc/login.defs)
	echo "${v:-$2}"
}
UID_MIN=$(defs SYS_UID_MIN 100)
UID_MAX=$(defs SYS_UID_MAX 999)
GID_MIN=$(defs SYS_GID_MIN 100)
GID_MAX=$(defs SYS_GID_MAX 999)

field() { getent "$1" "$2" | cut -d: -f"$3"; } # field passwd|group <name> <number>

inrange() { [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; } # inrange <n> <min> <max>

# Never adopt an account somebody else made: a normal user, a group with members, or a login shell would end up owning the
# database and the key, or the socket.
check_account() { # check_account <name>
	n=$1
	if getent group "$n" >/dev/null; then
		g=$(field group "$n" 3)
		{ [ "$g" != 0 ] && inrange "$g" "$GID_MIN" "$GID_MAX"; } || fail "group $n exists with gid $g, outside the system range $GID_MIN-$GID_MAX; refusing to use it (docs/RUNBOOK.md 1.3)"
		[ -z "$(field group "$n" 4)" ] || fail "group $n has members; refusing to use it"
	fi
	if getent passwd "$n" >/dev/null; then
		u=$(field passwd "$n" 3)
		{ [ "$u" != 0 ] && inrange "$u" "$UID_MIN" "$UID_MAX"; } || fail "user $n exists with uid $u, outside the system range $UID_MIN-$UID_MAX; refusing to use it (docs/RUNBOOK.md 1.3)"
		[ "$(field passwd "$n" 4)" = "$(field group "$n" 3)" ] || fail "the primary group of user $n is not the group $n; refusing to use it"
		case $(field passwd "$n" 7) in
		*/nologin | */false) ;;
		*) fail "user $n has a login shell; refusing to use it" ;;
		esac
	fi
}

group() {
	getent group "$1" >/dev/null || groupadd --system "$1"
}

user() { # user <name>: a system user with a group of the same name, no home, no login (check_account vetted an existing one)
	getent passwd "$1" >/dev/null ||
		useradd --system --gid "$1" --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$1"
}

# ---- /etc/subuid and /etc/subgid -----------------------------------------------------------------------------------------

# One "containers:2147483647:2147483648" line for UserNS=auto (podman-run(1)): an unused range of 2^31 ids that podman cuts
# into one range per container. An existing "containers:" line is the administrator's and stays. Without one, the range
# must be free: another owner's range that overlaps 2147483647..4294967294 is refused, not shared.
check_subid() { # check_subid <file>
	[ -e "$1" ] || return 0
	! grep -q '^containers:' "$1" || return 0
	awk -F: '$1 != "containers" && NF >= 3 && $2 + 0 <= 4294967294 && $2 + $3 - 1 >= 2147483647 { bad = 1 } END { exit bad }' "$1" ||
		fail "$1 has a range of another owner that overlaps 2147483647-4294967294, the range podman needs for UserNS=auto; free it or add a containers: line yourself"
}

subid() { # subid <file>
	[ -e "$1" ] || : >"$1"
	if ! grep -q '^containers:' "$1"; then
		[ ! -s "$1" ] || [ -z "$(tail -c1 "$1")" ] || echo >>"$1"
		echo 'containers:2147483647:2147483648' >>"$1"
	fi
}

# ---- directories ---------------------------------------------------------------------------------------------------------

# every directory of this script: install -d follows a symbolic link, so a link is refused
DIRS="/etc/vedette /var/lib/vedette-host /etc/containers /etc/containers/systemd /var/lib/vedette /var/lib/vedette-honeypot /var/lib/vedette-honeypot/config /var/lib/vedette-honeypot/log"

check_dirs() {
	for p in $DIRS; do
		[ ! -L "$p" ] || fail "$p is a symbolic link; refusing to use it"
	done
}

# made on the first install with this mode and owner; one that exists must already have them (data is never re-owned silently)
once() { # once <mode as stat -c %a prints it, without a leading 0> <user> <path>
	if [ -d "$3" ]; then
		have=$(stat -c '%a %U:%G' "$3")
		[ "$have" = "$1 $2:$2" ] || fail "$3 exists with mode and owner '$have', expected '$1 $2:$2'; fix it or move it away (docs/RUNBOOK.md 1.3)"
	else
		install -d -m "$1" -o "$2" -g "$2" "$3"
	fi
}

# ---- the unit ------------------------------------------------------------------------------------------------------------

enable_unit() {
	# Debian's own way (what dh_installsystemd writes): enabled on the first install, and an upgrade keeps an administrator's
	# `systemctl disable`. Plain systemctl where the helper is missing. Never starts the unit.
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper unmask "$UNIT" >/dev/null || true
		# was-enabled is true when the helper has no state yet, so the first install enables
		if deb-systemd-helper --quiet was-enabled "$UNIT"; then
			deb-systemd-helper enable "$UNIT" >/dev/null || true
		else
			deb-systemd-helper update-state "$UNIT" >/dev/null || true
		fi
	elif command -v systemctl >/dev/null 2>&1; then
		systemctl enable "$UNIT" >/dev/null 2>&1 || true
	fi
}

# restart_after_upgrade <previous version, "" on a first install>: an upgrade restarts a vedette-host that is running, so the
# new binary is the one that serves (what dh_installsystemd writes as restart-after-upgrade; `try-restart` does nothing for a
# unit that is stopped, so a first install, or an administrator's stop, is never turned into a start). The prerm leaves the
# old daemon running on upgrade on purpose; this is where it is replaced. Core does not depend on the host, so it is not
# restarted; the units that Require= the host (honeypot) come with it. Never fails the package: the installer starts the unit
# and checks the effect (install.sh). The caller guarantees systemd is running. deb-systemd-invoke honours policy-rc.d (an
# administrator or an image build that forbids starting daemons gets no restart): that is Debian's behaviour and is kept.
restart_after_upgrade() {
	[ -n "${1:-}" ] || return 0
	if command -v deb-systemd-invoke >/dev/null 2>&1; then
		deb-systemd-invoke try-restart "$UNIT" >/dev/null || true
	else
		systemctl --system try-restart "$UNIT" >/dev/null 2>&1 || true
	fi
}

case "${1:-}" in
configure)
	# 1. refuse before creating anything
	check_account "$CORE"
	check_account "$SENSOR"
	check_dirs
	check_subid /etc/subuid
	check_subid /etc/subgid

	# 2. accounts
	group "$CORE"
	group "$SENSOR"
	user "$CORE"
	user "$SENSOR"

	# 3. directories. install -d sets the mode and owner every run and never touches what is inside.
	# /etc/vedette: host.conf is written here by the installer (root-owned, not writable by others)
	install -d -m 0755 -o root -g root /etc/vedette
	# the helper's own state: runs, idempotency records, version records (its -state-dir default)
	install -d -m 0700 -o root -g root /var/lib/vedette-host
	# Quadlet units; the parents are root's and closed
	install -d -m 0755 -o root -g root /etc/containers /etc/containers/systemd
	# core_data (the default of core and of the installer's host.conf): the database and the key; core's alone, kept on purge
	once 700 "$CORE" /var/lib/vedette
	# honeypot folders (D-123 (1)): root's and closed above; config/ is written by core and read by the container; log/ is
	# written by the container and read by core.
	# log/ is THE CONTAINER'S after its first start: the unit mounts it with podman's :U, which gives it to uid 1000 of the honeypot image
	# (a subuid on the host) and init.py sets mode 0755 (D-162). So it is made here only when it is missing and is never checked or re-owned
	# afterwards: `once` would stop every later upgrade at "exists with mode and owner ...".
	install -d -m 0755 -o root -g root /var/lib/vedette-honeypot
	install -d -m 0755 -o "$CORE" -g "$CORE" /var/lib/vedette-honeypot/config
	[ -d /var/lib/vedette-honeypot/log ] || install -d -m 0755 -o "$CORE" -g "$CORE" /var/lib/vedette-honeypot/log

	subid /etc/subuid
	subid /etc/subgid

	enable_unit
	# the unit is new or changed. On an upgrade a running instance is restarted (after the reload). A dpkg that the helper itself
	# runs in its own cgroup would be killed by that restart (KillMode=control-group): a self-upgrade must run dpkg through
	# systemd-run (D-155 (8)); the installer's dpkg is not in the helper's cgroup.
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		restart_after_upgrade "${2:-}"
	fi
	;;
abort-upgrade | abort-remove | abort-deconfigure)
	# the prerm of a failed remove or upgrade may have disabled the unit: put it back (enable only, no start), as dh_installsystemd does
	enable_unit
	;;
*)
	echo "vedette-host postinst: unknown action '${1:-}'" >&2
	exit 1
	;;
esac
exit 0
