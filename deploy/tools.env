# The pins of the release tools that run on the maintainer's machine (D-159): none is shipped, none is a Go dependency.
# KEY=VALUE only (the Makefile includes this file). Images are named by the digest of the multi-architecture INDEX, so a re-pushed
# tag cannot change what runs (`docker buildx imagetools inspect <ref>` or the Docker-Content-Digest header of the index manifest;
# NOT the digest `podman image inspect` prints for one platform).
#
# To bump trivy: change the tag and the digest together in one commit, then `make sbom vuln-scan` on real images.
# Official image of aquasecurity/trivy (Apache-2.0), release v0.76.2 (2026-11-05), image tag 0.76.2.
TRIVY_IMAGE=docker.io/aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb

# WP-08f (D-164): minisign, the signing tool of the release builder and the reference the verifier is tested against. Official release
# 0.12 of jedisct1/minisign (ISC), a static binary in a tarball, pinned by the SHA-256 of the tarball and of the binary inside it for
# each architecture. scripts/release/minisign.sh downloads it into ~/.cache/vedette-minisign and checks both hashes (and the author's
# signature on the tarball against MINISIGN_AUTHOR_KEY, the key printed in the minisign README); `make release-interop` uses it.
# To bump: change every MINISIGN_* line in one commit, after `minisign -Vm <tarball> -P <author key>` on the new tarball.
MINISIGN_VERSION=0.12
MINISIGN_URL=https://github.com/jedisct1/minisign/releases/download/0.12/minisign-0.12-linux.tar.gz
MINISIGN_TARBALL_SHA256=9a599b48ba6eb7b1e80f12f36b94ceca7c00b7a5173c95c3efc88d9822957e73
MINISIGN_X86_64_SHA256=2c74dffcc1c9a5ee55957c60971998ace2b89f22585631594ec2152c588af8db
MINISIGN_AARCH64_SHA256=cec9f88be8c975af76854a53b4d49c3d257feae38d916edb0d16fb55aacd3000
MINISIGN_AUTHOR_KEY=RWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3
#
# Release keys (D-256): cosign, the tool that signs the images in the legacy format the box verifies (D-103: `sign --key
# --new-bundle-format=false --use-signing-config=false --tlog-upload=false`; those flags are gone from `cosign sign` v3, so the pin is v2).
# Official release v2.6.5 (2026-08-06) of sigstore/cosign (Apache-2.0), the last v2 patch (backports GHSA-fx35-mq7g-6g98), one static
# binary per OS and architecture, pinned by SHA-256. scripts/release/cosign.sh downloads it into ~/.cache/vedette-cosign and checks the
# hash. When the pin was taken (2026-11-11) the four hashes matched both the release's cosign_checksums.txt and GitHub's asset digests,
# and the keyless signature of cosign_checksums.txt verified (identity keyless@projectsigstore.iam.gserviceaccount.com, issuer
# https://accounts.google.com). To bump: change every COSIGN_* line in one commit after the same two checks on the new release.
COSIGN_VERSION=v2.6.5
COSIGN_URL=https://github.com/sigstore/cosign/releases/download/v2.6.5
COSIGN_DARWIN_ARM64_SHA256=4d41cc18f0563907c0c785b51db76e1d1af10db4422b605ba876b1758e1771ab
COSIGN_DARWIN_AMD64_SHA256=0f8a1a70c81de9740a2b62e91307ff396ce54e7dd80568d42411bb2d9d44269c
COSIGN_LINUX_AMD64_SHA256=c3b4f5410e608af03a5eb0aaac84a4313d8da131248e08ff1759ac70c79d1644
COSIGN_LINUX_ARM64_SHA256=426193b4c5da4d4d643e822f48fe0cc8a476ca1782a272704831f5a0cef716d7
