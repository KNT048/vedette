# The pins of the container images (D-146): the only place a version or a hash of anything inside an image is written.
# KEY=VALUE only (the Makefile includes this file and passes every value to the builds as --build-arg).
#
# To bump one: change the value together with its hash in the same commit, then `make images-check` (builds the images and checks them
# by effect) and, for nuclei, the lab checks of .ai/deferred/feat-sensor-nuclei.md (the flags of modules/scan/nucleiargv are those of the
# pinned version). Hashes come from the release itself: `gh api repos/projectdiscovery/nuclei/releases/tags/v<version>` (asset digest),
# `sha256sum` of the downloaded binary, `docker pull` for an image digest (the digest of the multi-arch index, not of one platform).

# Bases, by digest of the multi-architecture index. Debian 13 "trixie" slim; Go matches go.mod; distroless static has no shell.
DEBIAN_IMAGE=docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
GOLANG_IMAGE=docker.io/library/golang:1.26.10-trixie@sha256:fd9a91f0ece5664556f4851d06dce5e5b505a71166dffd385a03ba9d200b6983
DISTROLESS_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329

# nuclei (MIT), the release asset linux_<arch>.zip: SHA-256 of the zip (checked before unzip) and of the binary inside (checked after).
NUCLEI_VERSION=3.11.1
NUCLEI_ZIP_SHA256_AMD64=ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6
NUCLEI_ZIP_SHA256_ARM64=8044e3d9768ba0a744b2872c1a87e813006f013da97ca9f50f7661a4203bec07
NUCLEI_BIN_SHA256_AMD64=c49588140f357cbdddd5436dec11201953a4c5390faeec90777f9ee2cfd70251
NUCLEI_BIN_SHA256_ARM64=f27098e0be0cc370af52274611608ad61896d7f0a024e35b136327d39e725477

# The template pack (scripts/scanpack): built from the tag archive of nuclei-templates (MIT) at this version, whose SHA-256 is below;
# SCAN_PACK_VERSION is the pack's own version (AAAA.M.N), raised whenever the source version or the filter changes.
NUCLEI_TEMPLATES_VERSION=10.5.1
NUCLEI_TEMPLATES_SHA256=30fe1cfaced4635f886e4a2673641bba86998dceec28e468274524e789aa56eb
SCAN_PACK_VERSION=2026.11.1

# nmap is NOT in any image the project publishes (D-113 (7), D-4). vedette-host installs this exact Debian package on the box, on top of
# scan-base, from scan/Containerfile.onbox (slice SP-6). The same version is installed in the dev image of `make scan-image`.
NMAP_VERSION=7.95+dfsg-3
