# The `core` image (D-146): the server, statically linked (modernc SQLite is pure Go), on a base with no shell.
# Build from the repository root: `make core-image` (it builds the web interface first and embeds it with -tags webui, D-149; without the files the build fails). Used by the compose dev profile now; the release job (WP-08) signs and publishes it.
# Health: the unit's HealthCmd is the exec form ["/vedette","healthcheck"].
ARG GOLANG_IMAGE
ARG DEBIAN_IMAGE
ARG DISTROLESS_IMAGE

# Multi-arch (D-158): this stage runs on the BUILD machine and cross-compiles; the final stage has no RUN, so no CPU emulation is needed.
# MIN_SEQUENCE: core links internal/release for the signed mitigation packs (D-347), so it takes the index sequence floor like vedette-host.
FROM --platform=$BUILDPLATFORM ${GOLANG_IMAGE} AS build
ARG VERSION
ARG MIN_SEQUENCE
# TEST CHANNEL ONLY (make install-artifacts, #469): base64 of the generated internal/release/keys_prod.go that holds the PUBLIC throwaway keys
# of the test release, so that this core verifies the update documents of the test channel. Empty for every real build; refused unless VERSION has a -test. prerelease.
ARG TEST_KEYS_B64=""
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY . .
RUN set -eu; \
    printf '%s' "${VERSION}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' || { echo "VERSION must be SemVer without v, got '${VERSION}'" >&2; exit 1; }; \
    printf '%s' "${MIN_SEQUENCE}" | grep -Eq '^(0|[1-9][0-9]{0,17})$' || { echo "MIN_SEQUENCE must be a plain decimal number, got '${MIN_SEQUENCE}'" >&2; exit 1; }; \
    if [ -n "${TEST_KEYS_B64}" ]; then \
      case "${VERSION}" in *-test.*) ;; *) echo "TEST_KEYS_B64 is for a -test. version only, got '${VERSION}'" >&2; exit 1;; esac; \
      printf '%s' "${TEST_KEYS_B64}" | base64 -d > internal/release/keys_prod.go; \
    fi; \
    test -s internal/webui/licenses/web-third-party-licenses.txt || { echo "internal/webui/licenses/web-third-party-licenses.txt is missing: run make core-image (make webui-dist writes it)" >&2; exit 1; }; \
    test -s internal/webui/dist/index.html || { echo "internal/webui/dist/index.html is missing: run make core-image (it runs make webui-dist first)" >&2; exit 1; }; \
    if [ -e internal/webui/dist/mockServiceWorker.js ] || grep -rqE '\[MSW\]|mswjs' internal/webui/dist; then echo "internal/webui/dist holds the mock layer (MSW): build it with make webui-dist (VITE_API_MOCK=off)" >&2; exit 1; fi; \
    GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly \
    go build -tags webui -trimpath -ldflags "-s -w -X main.version=${VERSION} -X github.com/knt048/vedette/internal/release.MinSequenceText=${MIN_SEQUENCE}" -o /out/vedette ./cmd/vedette; \
    install -D -m 0644 internal/webui/licenses/web-third-party-licenses.txt /out/licenses/web-third-party-licenses.txt; \
    CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly go run ./scripts/hostlicenses -goos "${TARGETOS}" -goarch "${TARGETARCH}" -pkg ./cmd/vedette -name vedette-core -tags webui -out /out/licenses/third-party-licenses
RUN mkdir -p -m 0750 /out/dirs/var/lib/vedette /out/dirs/var/lib/vedette-creds/passive /out/dirs/var/lib/vedette-creds/active
# The signed confirmed mitigation packs (D-345): the regular files of content/mitigation/packs, hidden ones left out (a Finder .DS_Store
# would make the box refuse the folder), modes set here and not by COPY --chmod (podman applies it to folders too, scan-base).
RUN set -eu; install -d -m 0755 /out/content/mitigation; \
    find content/mitigation/packs -maxdepth 1 -type f ! -name '.*' -exec install -m 0644 {} /out/content/mitigation/ \;

# The osquery packages the box serves to the servers of the customer under /install/osquery/ (WP-26 slice 3, D-169 (10), agent-intake INV-5).
# deploy/osquery/PINS holds the version and the SHA-256 of each file. Each file is downloaded from the official release and checked against its
# pinned SHA-256 BEFORE it is copied anywhere; a missing pin or a mismatch fails the build (set -e). SHA256SUMS is made here from the pins, so the
# list the servers check against is exactly what was verified. Nothing is downloaded when the box runs. Files are unmodified (Apache-2.0 / GPL-2.0, THIRD_PARTY_NOTICES.md).
# This stage runs on the BUILD machine; the modes are set here because podman's COPY --chmod takes octal only and would apply it to folders too.
FROM --platform=$BUILDPLATFORM ${DEBIAN_IMAGE} AS osquery
COPY deploy/osquery/PINS /pins/osquery.pins
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    . /pins/osquery.pins; \
    [ -n "${OSQUERY_VERSION}" ] && [ -n "${OSQUERY_DEB_AMD64_SHA256}" ] && [ -n "${OSQUERY_RPM_X86_64_SHA256}" ] && [ -n "${OSQUERY_DEB_ARM64_SHA256}" ] && [ -n "${OSQUERY_RPM_AARCH64_SHA256}" ] && [ -n "${OSQUERY_MSI_SHA256}" ] || { echo "deploy/osquery/PINS is incomplete" >&2; exit 1; }; \
    deb="osquery_${OSQUERY_VERSION}-1.linux_amd64.deb"; rpm="osquery-${OSQUERY_VERSION}-1.linux.x86_64.rpm"; msi="osquery-${OSQUERY_VERSION}.msi"; \
    deba="osquery_${OSQUERY_VERSION}-1.linux_arm64.deb"; rpma="osquery-${OSQUERY_VERSION}-1.linux.aarch64.rpm"; \
    mkdir -p -m 0755 /out; \
    for f in "${deb}" "${rpm}" "${deba}" "${rpma}" "${msi}"; do \
      curl -fsSL --proto '=https' --proto-redir '=https' --max-time 600 -o "/out/${f}" "https://github.com/osquery/osquery/releases/download/${OSQUERY_VERSION}/${f}"; \
    done; \
    echo "${OSQUERY_DEB_AMD64_SHA256}  /out/${deb}" | sha256sum -c -; \
    echo "${OSQUERY_RPM_X86_64_SHA256}  /out/${rpm}" | sha256sum -c -; \
    echo "${OSQUERY_DEB_ARM64_SHA256}  /out/${deba}" | sha256sum -c -; \
    echo "${OSQUERY_RPM_AARCH64_SHA256}  /out/${rpma}" | sha256sum -c -; \
    echo "${OSQUERY_MSI_SHA256}  /out/${msi}" | sha256sum -c -; \
    printf '%s  %s\n' "${OSQUERY_DEB_AMD64_SHA256}" "${deb}" "${OSQUERY_RPM_X86_64_SHA256}" "${rpm}" "${OSQUERY_DEB_ARM64_SHA256}" "${deba}" "${OSQUERY_RPM_AARCH64_SHA256}" "${rpma}" "${OSQUERY_MSI_SHA256}" "${msi}" > /out/SHA256SUMS; \
    chmod 0644 /out/*
# The licence texts of osquery (Apache-2.0 section 4(a): a copy of the licence goes with every redistribution; the files are offered under Apache-2.0,
# the GPL-2.0 text goes with them because the project is dual-licensed). They are the files of the osquery 5.12.1 source tree (LICENSE,
# LICENSE-Apache-2.0, LICENSE-GPL-2.0), kept in the repository next to PINS; the build checks each against its pinned SHA-256, so an edited text fails it.
# The packages are not opened at build time (they are not extracted or read; ~80 MB), the texts come from the tag the packages are built from.
COPY deploy/osquery/LICENSE deploy/osquery/LICENSE-Apache-2.0 deploy/osquery/LICENSE-GPL-2.0 /lic/
RUN set -eu; \
    . /pins/osquery.pins; \
    [ -n "${OSQUERY_LICENSE_SHA256}" ] && [ -n "${OSQUERY_LICENSE_APACHE_SHA256}" ] && [ -n "${OSQUERY_LICENSE_GPL2_SHA256}" ] || { echo "deploy/osquery/PINS lacks the license hashes" >&2; exit 1; }; \
    echo "${OSQUERY_LICENSE_SHA256}  /lic/LICENSE" | sha256sum -c -; \
    echo "${OSQUERY_LICENSE_APACHE_SHA256}  /lic/LICENSE-Apache-2.0" | sha256sum -c -; \
    echo "${OSQUERY_LICENSE_GPL2_SHA256}  /lic/LICENSE-GPL-2.0" | sha256sum -c -; \
    chmod 0644 /lic/*

FROM ${DISTROLESS_IMAGE}
ARG VERSION
LABEL org.opencontainers.image.title="vedette-core" org.opencontainers.image.version="${VERSION}" org.opencontainers.image.source="https://github.com/KNT048/vedette" org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /out/vedette /vedette
# The third-party licenses (D-155 (10)): the Go license and the license file of every Go module linked into /vedette, made by scripts/hostlicenses
# from the same module graph as the binary (a linked module with no license file fails the build); the licenses of the npm packages of the
# embedded web interface (made by make webui-dist, scripts/weblicenses) and the osquery license texts sit next to it.
COPY --from=build /out/licenses/ /usr/share/doc/vedette/
COPY --from=osquery /lic/ /usr/share/doc/vedette/osquery/
# The pinned osquery packages: a leaf directory that does not exist yet (the default of -osquery-dir). Root-owned, world-readable; core only reads it.
COPY --from=osquery /out/ /usr/share/vedette/osquery/
# The data and credentials directories exist in the image, owned by the user below, so a NEW named volume mounted on one of them
# starts with that owner (Docker and Podman copy the image's directory into an empty volume): the container-only compose needs no
# root step (D-168 (5)). The appliance bind-mounts /var/lib/vedette, and its two creds volumes are Quadlet volumes with an explicit
# User=/Group= (host/ops/testdata/units/vedette-creds-*.volume), which Podman keeps; the lab confirms it (deferred line).
# One COPY per leaf directory, each to a destination that does not exist yet: a COPY of /out/dirs/ to / would also give /var and
# /var/lib (root-owned in distroless) to 65532 (BuildKit and buildah both overwrite the owner of existing parents).
COPY --from=build --chown=65532:65532 --chmod=0750 /out/dirs/var/lib/vedette/ /var/lib/vedette/
COPY --from=build --chown=65532:65532 --chmod=0750 /out/dirs/var/lib/vedette-creds/ /var/lib/vedette-creds/
# The confirmed mitigation packs of this release, signed with the release minisign key (D-345, `make release-packs`); owned by root
# and read-only for core, which loads them only when the signature holds (job mitigation/load-packs). Modes come from the build stage.
COPY --from=build /out/content/mitigation/ /opt/vedette/content/mitigation/
USER 65532:65532
ENTRYPOINT ["/vedette"]
