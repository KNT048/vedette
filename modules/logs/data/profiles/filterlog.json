{
  "id": "filterlog",
  "title": "pfSense and OPNsense filterlog CSV (raw filter log format, IPv4 connections from the LAN side)",
  "kinds": [
    "pfsense",
    "opnsense"
  ],
  "rule": {
    "type": "template",
    "apps": [
      "filterlog"
    ],
    "prefix": "^[0-9]{0,10},[^,]{0,10},[^,]{0,32},[0-9A-Za-z]{0,40},(?P<head>[A-Za-z0-9_.-]{1,16},[a-z-]{1,16},[a-z]{3,6},(?:in|out)),",
    "conn_patterns": [
      {
        "pattern": "^[0-9]{0,10},[^,]{0,10},[^,]{0,32},[0-9A-Za-z]{0,40},[A-Za-z0-9_.-]{1,16},[a-z-]{1,16},pass,in,4,[^,]{0,6},[^,]{0,4},[0-9]{1,3},[0-9]{0,6},[0-9]{0,6},[A-Za-z+]{1,12},6,tcp,[0-9]{1,5},(?P<local>\\d{1,3}(?:\\.\\d{1,3}){3}),(?P<dest>\\d{1,3}(?:\\.\\d{1,3}){3}),[0-9]{1,5},[0-9]{1,5},[0-9]{1,5},S[EW]{0,2}(?:,|$)"
      },
      {
        "pattern": "^[0-9]{0,10},[^,]{0,10},[^,]{0,32},[0-9A-Za-z]{0,40},[A-Za-z0-9_.-]{1,16},[a-z-]{1,16},pass,in,4,[^,]{0,6},[^,]{0,4},[0-9]{1,3},[0-9]{0,6},[0-9]{0,6},[A-Za-z+]{1,12},17,udp,[0-9]{1,5},(?P<local>\\d{1,3}(?:\\.\\d{1,3}){3}),(?P<dest>\\d{1,3}(?:\\.\\d{1,3}){3}),[0-9]{1,5},[0-9]{1,5},[0-9]{1,5}(?:,|$)"
      },
      {
        "pattern": "^[0-9]{0,10},[^,]{0,10},[^,]{0,32},[0-9A-Za-z]{0,40},[A-Za-z0-9_.-]{1,16},[a-z-]{1,16},(?:block|reject),in,4,[^,]{0,6},[^,]{0,4},[0-9]{1,3},[0-9]{0,6},[0-9]{0,6},[A-Za-z+]{1,12},6,tcp,[0-9]{1,5},(?P<local>\\d{1,3}(?:\\.\\d{1,3}){3}),(?P<dest>\\d{1,3}(?:\\.\\d{1,3}){3}),[0-9]{1,5},[0-9]{1,5},[0-9]{1,5},S[EW]{0,2}(?:,|$)",
        "blocked": true
      },
      {
        "pattern": "^[0-9]{0,10},[^,]{0,10},[^,]{0,32},[0-9A-Za-z]{0,40},[A-Za-z0-9_.-]{1,16},[a-z-]{1,16},(?:block|reject),in,4,[^,]{0,6},[^,]{0,4},[0-9]{1,3},[0-9]{0,6},[0-9]{0,6},[A-Za-z+]{1,12},17,udp,[0-9]{1,5},(?P<local>\\d{1,3}(?:\\.\\d{1,3}){3}),(?P<dest>\\d{1,3}(?:\\.\\d{1,3}){3}),[0-9]{1,5},[0-9]{1,5},[0-9]{1,5}(?:,|$)",
        "blocked": true
      }
    ]
  },
  "samples": [
    {
      "line": "<134>Nov  9 10:00:00 filterlog[53123]: 5,,,1000000103,igc1,match,pass,in,4,0x0,,64,41237,0,DF,6,tcp,60,192.168.10.113,185.220.101.47,51234,443,0,S,2174350711,,64240,,mss;sackOK;TS;nop;wscale",
      "signature": "igc1,match,pass,in: <n>,<hex>,,<n>,<n>,<n>,DF,<n>,tcp,<n>,<ip>,<ip>,<n>,<n>,<n>,S,<hex>,,<n>,,mss;sackOK;TS;nop;wscale",
      "local": "192.168.10.113",
      "dests": [
        "ip:185.220.101.47"
      ]
    },
    {
      "line": "<134>Nov  9 10:00:01 filterlog[53123]: 12,,,1000000105,igc1,match,block,in,4,0x0,,64,41238,0,DF,6,tcp,60,192.168.10.113,185.220.101.47,51235,23,0,S,2174350712,,64240,,mss",
      "signature": "igc1,match,block,in: <n>,<hex>,,<n>,<n>,<n>,DF,<n>,tcp,<n>,<ip>,<ip>,<n>,<n>,<n>,S,<hex>,,<n>,,mss",
      "blocked": true,
      "local": "192.168.10.113",
      "dests": [
        "ip:185.220.101.47"
      ]
    }
  ]
}
