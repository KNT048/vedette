# The `scan` base image (D-113 (7), D-125 (4), D-146): Debian slim + vedette-sensor + nuclei + the safe template pack. This is the image the
# project signs and publishes. It holds NO nmap (D-4, docs/LEGAL.md): vedette-host adds it on the box (scan/Containerfile.onbox).
# Build from the repository root: `make scan-base-image` (builds the pack first, `make scan-pack`, and passes pins.env as build arguments).
#
# nuclei is NOT the upstream release binary: it is built here from the source archive of the pinned tag (SHA-256 checked before it is
# unpacked) with the pinned Go (GOLANG_IMAGE) and our patched go.mod/go.sum (scan-base/nuclei/, D-319), so the standard library and the
# modules in it carry the security fixes upstream has not shipped yet; go.sum verifies every module. Nothing is updated at run time (nuclei
# runs with -duc, -ni).
# The pack is the output of scripts/scanpack: templates/ -> /usr/share/vedette/nuclei-templates (nucleiargv.TemplatesDir), index.json ->
# /usr/local/share/vedette/nuclei-pack/index.json (the default of `vedette-sensor active --nuclei-index`). Plain files and folders only.
# Init: the unit runs this image under podman's init (RunInit=true), so vedette-sensor is not a subreaper.
ARG DEBIAN_IMAGE
ARG GOLANG_IMAGE

# Multi-arch (D-158): every stage that has a RUN (build, nuclei, pack) runs on the BUILD machine ($BUILDPLATFORM) and produces files for
# $TARGETARCH; the final stage, the only one of the target architecture, has COPY and metadata only, so no CPU emulation is needed.
FROM --platform=$BUILDPLATFORM ${GOLANG_IMAGE} AS build
ARG VERSION
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY . .
RUN set -eu; \
    printf '%s' "${VERSION}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' || { echo "VERSION must be SemVer without v, got '${VERSION}'" >&2; exit 1; }; \
    GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/vedette-sensor ./cmd/vedette-sensor; \
    CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly go run ./scripts/hostlicenses -goos "${TARGETOS}" -goarch "${TARGETARCH}" -pkg ./cmd/vedette-sensor -name vedette-sensor -out /out/licenses/third-party-licenses; \
    CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly go build -trimpath -o /tools/hostlicenses ./scripts/hostlicenses; \
    test -s /etc/ssl/certs/ca-certificates.crt && test -s /usr/share/doc/ca-certificates/copyright || { echo "the Go image has no ca-certificates" >&2; exit 1; }

FROM --platform=$BUILDPLATFORM ${GOLANG_IMAGE} AS nuclei
ARG TARGETOS
ARG TARGETARCH
ARG NUCLEI_VERSION
ARG NUCLEI_SRC_SHA256
WORKDIR /nuclei
# Our patched go.mod/go.sum (README.md there): nothing else of the repository is needed here.
COPY deploy/containers/scan-base/nuclei/go.mod deploy/containers/scan-base/nuclei/go.sum /patched/
# The licence-file generator of the other images (scripts/hostlicenses, built for this machine in the build stage), run here over
# ./cmd/nuclei: the licence of every module linked into nuclei, offline (GOPROXY=off) from the modules the build has just fetched (D-454).
COPY --from=build /tools/hostlicenses /usr/local/bin/hostlicenses
RUN set -eu; \
    [ -n "${NUCLEI_VERSION}" ] || exit 1; \
    [ -n "${NUCLEI_SRC_SHA256}" ] || exit 1; \
    curl -fsSL --max-time 300 -o /tmp/nuclei.tar.gz "https://github.com/projectdiscovery/nuclei/archive/refs/tags/v${NUCLEI_VERSION}.tar.gz"; \
    echo "${NUCLEI_SRC_SHA256}  /tmp/nuclei.tar.gz" | sha256sum -c -; \
    mkdir -p /out /nuclei/src; tar -xzf /tmp/nuclei.tar.gz --strip-components=1 -C /nuclei/src; \
    cp /patched/go.mod /patched/go.sum /nuclei/src/; \
    grep -Fq "Version = \`v${NUCLEI_VERSION}\`" /nuclei/src/pkg/catalog/config/constants.go || { echo "the source is not nuclei v${NUCLEI_VERSION}" >&2; exit 1; }; \
    cd /nuclei/src; \
    GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly \
    go build -trimpath -ldflags "-s -w" -o /out/nuclei ./cmd/nuclei; \
    cp LICENSE.md /out/LICENSE.md; \
    CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly GOPROXY=off \
    hostlicenses -goos "${TARGETOS}" -goarch "${TARGETARCH}" -pkg ./cmd/nuclei -name nuclei -out /out/third-party-licenses; \
    chmod 0755 /out/nuclei

# The files of the image that are not binaries, with their modes set and the pack checked, on the build machine.
# (podman's COPY --chmod takes octal only and would apply it to folders too, so the modes are set here, for docker and podman alike)
FROM --platform=$BUILDPLATFORM ${DEBIAN_IMAGE} AS pack
ARG SCAN_PACK_VERSION
COPY --from=nuclei /out/LICENSE.md /usr/local/share/vedette/licenses/nuclei-LICENSE.md
COPY --from=nuclei /out/third-party-licenses /usr/local/share/vedette/licenses/nuclei-third-party-licenses
# The same texts at the standard place of the other images (/usr/share/doc/vedette/, D-155 (10)).
COPY --from=nuclei /out/LICENSE.md /usr/share/doc/vedette/nuclei-LICENSE.md
COPY --from=nuclei /out/third-party-licenses /usr/share/doc/vedette/nuclei-third-party-licenses
COPY deploy/containers/scan-base/pack/templates/ /usr/share/vedette/nuclei-templates/
COPY deploy/containers/scan-base/pack/index.json /usr/local/share/vedette/nuclei-pack/index.json
COPY deploy/containers/scan-base/pack/LICENSE-nuclei-templates.md /usr/local/share/vedette/licenses/nuclei-templates-LICENSE.md
COPY deploy/containers/scan-base/pack/LICENSE-nuclei-templates.md /usr/share/doc/vedette/nuclei-templates-LICENSE.md
RUN set -eu; \
    chmod -R a+rX /usr/share/vedette /usr/local/share/vedette /usr/share/doc/vedette; \
    [ -n "${SCAN_PACK_VERSION}" ] || exit 1; \
    grep -Fq "\"version\": \"${SCAN_PACK_VERSION}\"" /usr/local/share/vedette/nuclei-pack/index.json || { echo "index.json is not pack version ${SCAN_PACK_VERSION}: a stale pack (make scan-pack)" >&2; exit 1; }

FROM ${DEBIAN_IMAGE}
ARG VERSION
LABEL org.opencontainers.image.title="vedette-scan-base" org.opencontainers.image.version="${VERSION}" org.opencontainers.image.source="https://github.com/KNT048/vedette" org.opencontainers.image.licenses="Apache-2.0 AND MIT"
COPY --from=build /out/vedette-sensor /vedette-sensor
COPY --from=nuclei /out/nuclei /usr/local/bin/nuclei
COPY --from=pack /usr/share/vedette/ /usr/share/vedette/
COPY --from=pack /usr/local/share/vedette/ /usr/local/share/vedette/
# Third-party licenses: the Go modules linked into vedette-sensor and into nuclei (scripts/hostlicenses) and the nuclei and template-pack texts.
COPY --from=build /out/licenses/ /usr/share/doc/vedette/
COPY --from=pack /usr/share/doc/vedette/ /usr/share/doc/vedette/
# The trust roots of the worker's own-IP fence (D-514: HTTPS to the three public IP services; Go reads this file). The Debian
# ca-certificates package of the Go image, which is pinned by digest (pins.env GOLANG_IMAGE), with its copyright file: copied, not
# installed, so this stage stays COPY-only (no apt, no emulation, D-158).
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /usr/share/doc/ca-certificates/copyright /usr/share/doc/ca-certificates/copyright
USER 65532:65532
ENTRYPOINT ["/vedette-sensor"]
